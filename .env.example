# Copy this file to ".env" for Docker or local use. On Vercel, add these in
# Project → Settings → Environment Variables instead. Never commit real values.

# REQUIRED in production. A long random string that encrypts your API keys,
# chats and files. Generate one with:  npm run secret
# Keep a backup somewhere safe and never change it — if it changes, everything
# already stored becomes unreadable.
APP_SECRET=

# REQUIRED in production. A code you make up. You type it once on the setup
# page to create the owner account (so nobody else can claim your site first).
SETUP_CODE=

# Postgres connection string. On Vercel the Neon integration fills this in for
# you. Leave empty to use the built-in database stored in ./data (or DATA_DIR).
DATABASE_URL=

# Optional: where the built-in database and generated files live (default ./data)
# DATA_DIR=/data
